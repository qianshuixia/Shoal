{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shoal",
  "version": "0.1.10",
  "identifier": "dev.shoal.desktop",
  "build": {
    "beforeBuildCommand": "node ../scripts/stage-desktop.mjs",
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../bundle/": "app/"
    }
  }
}
